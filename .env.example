# Copy to .env and adjust. All backend settings use the DOTA_SENSEI_ prefix.

# --- Ports (chosen to avoid opik / psy-computational-learning collisions) ---
# frontend dev server 5273 | api 8273 | postgres 5473
DOTA_SENSEI_API_HOST=127.0.0.1
DOTA_SENSEI_API_PORT=8273
DOTA_SENSEI_FRONTEND_ORIGIN=http://localhost:5273

# The origin the browser sees, and what Steam redirects back to. In dev this is
# the Vite server (which proxies /api), NOT the backend port — the session cookie
# must be set on the same host the app is served from.
DOTA_SENSEI_PUBLIC_BASE_URL=http://localhost:5273

# --- Sessions ---
# Signs the session cookie. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DOTA_SENSEI_SECRET_KEY=dev-only-insecure-change-me
# Set true when serving over HTTPS.
DOTA_SENSEI_SESSION_HTTPS_ONLY=false

# --- Database ---
POSTGRES_PORT=5473
POSTGRES_USER=dota_sensei
POSTGRES_PASSWORD=dota_sensei
POSTGRES_DB=dota_sensei
DOTA_SENSEI_DATABASE_URL=postgresql+asyncpg://dota_sensei:dota_sensei@localhost:5473/dota_sensei

# --- OpenDota ---
# Optional. Without a key you get 2000 free calls/day at 60/min.
DOTA_SENSEI_OPENDOTA_API_KEY=

# Optional fallback account id for when nobody is signed in (the number in your
# Dotabuff / OpenDota profile URL). Signing in through Steam supersedes this.
DOTA_SENSEI_DEFAULT_ACCOUNT_ID=
